#!/usr/bin/env bash
# A fresh phone for the room: an emulator of the person's AVD, read-only so
# rooms can share it, and the app it tests running on the room's port
# (the phone reaches the computer at 10.0.2.2).
set -euo pipefail
: "${ANDROID_HOME:?the Android SDK (pass_env)}" "${ADMINISTRATION_AVD:?the AVD to boot (pass_env)}"
adb=$ANDROID_HOME/platform-tools/adb
here=$ADMINISTRATION_EQUIPMENT_DIR
mkdir -p "$here"

cp -R "$ADMINISTRATION_MAIN/app" "$here/notes"
python3 "$here/notes/server.py" "$ADMINISTRATION_PORT" >"$here/notes.log" 2>&1 </dev/null &

# A console port no other room holds (even, 5554-5680), claimed with mkdir.
claims=${TMPDIR:-/tmp}/phone-demo-claims
mkdir -p "$claims"
find "$claims" -mindepth 1 -maxdepth 1 -mmin +30 -exec rmdir {} + 2>/dev/null || true
port=
for p in $(seq 5554 2 5680); do
  if mkdir "$claims/$p" 2>/dev/null; then
    if (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; then rmdir "$claims/$p"; continue; fi
    port=$p; break
  fi
done
[ -n "$port" ] || { echo "no free emulator port" >&2; exit 1; }
echo "$claims/$port" > "$here/claim"
serial=emulator-$port
echo "$serial" > "$here/serial"

window=-no-window
[ "${ADMINISTRATION_SHOW:-}" = 1 ] && window=
"$ANDROID_HOME/emulator/emulator" -avd "$ADMINISTRATION_AVD" -read-only -no-snapshot \
  -no-audio -no-boot-anim $window -port "$port" >"$here/emulator.log" 2>&1 </dev/null &
emu=$!

"$adb" start-server >/dev/null 2>&1 || true
for _ in $(seq 180); do
  [ "$("$adb" -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] && break
  kill -0 "$emu" 2>/dev/null || { tail -5 "$here/emulator.log" >&2; exit 1; }
  sleep 1
done
[ "$("$adb" -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] || { echo "the phone didn't boot" >&2; exit 1; }
# Its network comes up a moment after boot; the app is unreachable without it.
for _ in $(seq 60); do
  "$adb" -s "$serial" shell ping -c1 -W1 10.0.2.2 >/dev/null 2>&1 && break
  sleep 1
done
"$adb" -s "$serial" shell ping -c1 -W1 10.0.2.2 >/dev/null 2>&1 || { echo "the phone has no network" >&2; exit 1; }
"$adb" -s "$serial" shell input keyevent 82 >/dev/null   # wake and unlock
"$adb" -s "$serial" shell am start -a android.intent.action.VIEW \
  -d "http://10.0.2.2:$ADMINISTRATION_PORT/" org.chromium.webview_shell >/dev/null
sleep 3
echo "SERIAL=$serial"
