#!/usr/bin/env bash
# The phone's driver for the Administration's screen: SERIAL ACTION ARGS...
# (docs/equipment.md has the actions). Coordinates are the phone's pixels.
set -euo pipefail
serial=$1 action=$2; shift 2
adb() { "$ANDROID_HOME/platform-tools/adb" -s "$serial" "$@"; }
case $action in
  screenshot) adb exec-out screencap -p ;;
  click) if [ -n "${3:-}" ]; then adb shell input swipe "$1" "$2" "$1" "$2" "$3"; else adb shell input tap "$1" "$2"; fi ;;
  drag) adb shell input swipe "$1" "$2" "$3" "$4" 400 ;;
  scroll) adb shell input swipe "$1" "$2" "$(($1 - $3))" "$(($2 - $4))" 300 ;;
  type)
    # input text takes one word: spaces as %s, the rest quoted for the
    # phone's shell.
    t=${1// /%s}
    t=${t//\'/\'\\\'\'}
    adb shell "input text '$t'" ;;
  key)
    case $1 in
      Back) k=4 ;; Home) k=3 ;; Enter) k=66 ;; Tab) k=61 ;; Backspace) k=67 ;; AppSwitch) k=187 ;;
      *) echo "no key $1 on this phone (Back, Home, Enter, Tab, Backspace, AppSwitch)" >&2; exit 2 ;;
    esac
    adb shell input keyevent "$k" ;;
  *) echo "no action $action" >&2; exit 2 ;;
esac
